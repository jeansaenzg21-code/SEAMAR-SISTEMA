# =========================
# DATABASE
# =========================
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
DB_NAME=

# =========================
# AUTHENTICATION
# =========================
SESSION_COOKIE_NAME=app_session
SESSION_MAX_AGE_SECONDS=28800

# =========================
# MICROSOFT AZURE / GRAPH
# =========================
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# =========================
# ONEDRIVE
# =========================
ONEDRIVE_USER=
OUTLOOK_USER=
OUTLOOK_DEFAULT_RECIPIENT=

# OneDrive folder IDs (reemplazar con los IDs reales)
ONEDRIVE_FOLDER_CONTRATOS=
ONEDRIVE_FOLDER_SISTEMA_SEAMAR=
ONEDRIVE_FOLDER_DOCUMENTOS=
ONEDRIVE_FOLDER_DOCUMENTOS_RESPALDO=
ONEDRIVE_FOLDER_ESTADOS_BANCARIOS=
ONEDRIVE_FOLDER_VALORIZACIONES=
ONEDRIVE_FOLDER_ORDENES_SERVICIO=

# Opcional: módulo Cuentas por Pagar (Oscar). Si se deja vacío, el sistema
# resuelve y crea automáticamente la carpeta "SistemaSeamar/Repositorio".
# Puede forzarse con el ID de la carpeta de OneDrive deseada.
ONEDRIVE_FOLDER_FACTURAS_OSCAR=

# =========================
# AI / OPENAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# =========================
# AI / GEMINI
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =========================
# BUSINESS DATA
# =========================
SEAMAR_RUC=

# =========================
# APPLICATION URLs
# =========================
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# =========================
# BACKUP / RESTAURACIÓN
# =========================
# Directorio donde se almacenan los respaldos .sql (fuera de public).
# Default: ./backups (relativo a la raíz del proyecto).
BACKUP_DIR=

# Rutas a los binarios de MySQL 8 (si no están en el PATH).
BACKUP_MYSQLDUMP_PATH=
BACKUP_MYSQL_PATH=

# Retención: cantidad de respaldos diarios / semanales / mensuales a conservar.
BACKUP_RETENTION_DAILY_DAYS=7
BACKUP_RETENTION_WEEKLY_COUNT=4
BACKUP_RETENTION_MONTHLY_COUNT=6

# Tiempo máximo (minutos) antes de considerar un lock de backup vencido.
BACKUP_MAX_LOCK_MINUTES=45

# =========================
# PYTHON
# =========================
# Ruta al intérprete de Python (Windows: C:/.../python.exe ; Linux: /usr/bin/python3).
# Si se deja vacío, el sistema usa "python" en Windows y /usr/bin/python3 en Linux.
PYTHON_PATH=

# =========================
# OCR SERVICE
# =========================
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_SERVICE_HOST=127.0.0.1
OCR_SERVICE_PORT=8000
OCR_MAX_WORKERS=1

# =========================
# EXCEL IMPORTER DEFAULTS
# =========================
EXCEL_DEFAULT_PROVEEDOR=
EXCEL_DEFAULT_RUC=
EXCEL_DEFAULT_MONEDA=PEN
EXCEL_DEFAULT_NEGOCIO=

# =========================
# SMTP (opcional - se usa Microsoft Graph por defecto)
# =========================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
